;; Clock
(defpoll TIME :interval "1s" "date +\"%H:%M\"")
(defpoll TIME_TT :interval "1s" "~/.config/eww/widgets/clock/get-clock-tooltip.sh")

(defwidget clock []
  (button :class "clock" :onclick "echo 'Clock clicked'" :tooltip {TIME_TT}
    (box :spacing 2
      (image :path "/usr/share/icons/breeze-dark/actions/22/clock.svg"
             :image-width 28
             :image-height 28)
      (label :text "${TIME}")))) 