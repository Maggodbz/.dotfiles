;; Backlight
(defpoll BRT :interval "1s"
  "brightnessctl info | grep -oE '\\([0-9]+%\\)' | tr -d '()'")

(defwidget backlight []
  (button :class "backlight" :onclick "echo 'Backlight clicked'"
    (box :spacing 2
      (image :path "/usr/share/icons/breeze-dark/actions/22/brightness-low.svg"
             :image-width 28
             :image-height 28)
      (label :text "${BRT}")))) 