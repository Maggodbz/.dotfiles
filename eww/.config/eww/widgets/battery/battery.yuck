;; Battery
(defpoll BATTERY :interval "10s"
  "~/.config/eww/widgets/battery/battery.sh")

(defwidget battery []
  (button :class "battery" :onclick "echo 'Battery clicked'" :tooltip {BATTERY.tooltip}
    (box :spacing 2
      (image :path "/usr/share/icons/breeze-dark/status/24/${BATTERY.icon_name}.svg"
             :image-width 28 
             :image-height 28)
      (label :text {BATTERY.percentage} :style {BATTERY.style}))))