;; Hyper‐mode
(defpoll HYPER :interval "100ms"
  "./widgets/hyper/hyper-mode-status.sh")

(defpoll SYSTEM_INFO_TT :interval "2s"
  "~/.config/eww/widgets/hyper/system-info-tooltip.sh")

(defwidget hyper-button []
  (box :orientation "h" :class "center" :spacing 8
    (button
      :class {HYPER.class}
      :onclick "~/.config/eww/widgets/hyper/toggle-mode.sh"
      :tooltip {SYSTEM_INFO_TT}
      (label :text {HYPER.text}))))  