;; System Info Tooltip Window

(defwindow system-info-tooltip
  :monitor    0
  :geometry   (geometry :x "50%" :y "5%" :width "320px" :height "400px" :anchor "top center")
  :exclusive  false
  :namespace  "eww-system-info"
  :windowtype "utility"
  :wm-ignore  true
  :stacking   "fg"
  (system-info-tooltip))
