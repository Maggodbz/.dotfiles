/* Kaya TUI — focused Nord-themed chat */

Screen {
    background: #2E3440;
    color: #ECEFF4;
}

/* ── Top status bar ─────────────────────────────────────────── */

#status-bar {
    dock: top;
    height: 3;
    background: #3B4252;
    color: #ECEFF4;
    padding: 0 2;
    layout: horizontal;
}

#status-model {
    width: 1fr;
    color: #88C0D0;
    text-style: bold;
    content-align: left middle;
}

#status-title {
    width: 1fr;
    color: #ECEFF4;
    text-style: bold;
    content-align: center middle;
}

#status-info {
    width: 1fr;
    content-align: right middle;
    color: #4C566A;
}

/* ── Main area: orb left, transcript right ──────────────────── */

#main-area {
    layout: horizontal;
    height: 1fr;
}

#orb {
    width: 2fr;
    min-width: 20;
    height: 100%;
    border: round #4C566A;
    border-title-color: #88C0D0;
    border-title-align: center;
    border-title-style: bold;
}

#chat-scroll {
    width: 3fr;
    height: 100%;
    border: round #4C566A;
    border-title-color: #88C0D0;
    border-title-style: bold;
    padding: 1 2;
    scrollbar-color: #4C566A;
    scrollbar-color-hover: #88C0D0;
    scrollbar-color-active: #88C0D0;
}

/* ── Input bar ──────────────────────────────────────────────── */

#input-bar {
    dock: bottom;
    height: 3;
    background: #3B4252;
    padding: 0 1;
    layout: horizontal;
}

#input-prompt {
    width: 4;
    color: #88C0D0;
    text-style: bold;
    content-align: left middle;
}

#input-field {
    width: 1fr;
    background: #3B4252;
    color: #ECEFF4;
    border: none;
    padding: 0;
}

#input-field:focus {
    border: none;
}

/* Scrollbar colors are set on the scroll containers above */

/* ── Chat messages ──────────────────────────────────────────── */

.user-msg {
    color: #88C0D0;
    margin: 0 0 1 0;
}

.assistant-msg {
    color: #D8DEE9;
    margin: 0 0 1 0;
}

.thinking-msg {
    color: #4C566A;
    text-style: italic;
}

/* ── Context bar ────────────────────────────────────────────── */

.ctx-bar {
    color: #4C566A;
    height: 1;
}

.ctx-bar.warn {
    color: #EBCB8B;
}

.ctx-bar.danger {
    color: #BF616A;
}
