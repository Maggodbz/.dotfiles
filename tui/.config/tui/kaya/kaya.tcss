/* Kaya — a console, not a dashboard.
 *
 * background   #080D14    raised surface  #0D1520    border  #1C2B3D
 * text         #D9E2E8    dim             #6F8190
 * cyan #66D9EF   blue #4D8FC8   amber #D9A75F   green #71C48D   red #D86F6F
 */

Screen {
    background: #080D14;
    color: #D9E2E8;
}

/* ── System strips ──────────────────────────────────────────── */

#status-bar {
    dock: top;
    height: 2;
    padding: 0 2;
    layout: horizontal;
    background: #080D14;
    border-bottom: solid #1C2B3D;
}

#status-brand { width: auto; content-align: left middle; }
#status-model { width: 1fr; padding: 0 4; content-align: left middle; }
#status-context { width: auto; padding: 0 4 0 0; content-align: right middle; }
#status-uptime { width: auto; content-align: right middle; }

#footer-bar {
    dock: bottom;
    height: 2;
    padding: 0 2;
    layout: horizontal;
    background: #080D14;
    border-top: solid #1C2B3D;
}

#footer-left { width: auto; content-align: left middle; }
#footer-center { width: 1fr; content-align: center middle; }
#footer-right { width: auto; content-align: right middle; }

/* ── Main area: activity | Kaya | memory ────────────────────── */

#main-area {
    layout: horizontal;
    height: 1fr;
}

.side-panel {
    width: 1fr;
    min-width: 20;
    height: 100%;
    margin: 1;
    background: #0D1520;
    border: round #1C2B3D;
}

.panel-header {
    height: 1;
    padding: 0 2;
    background: #0D1520;
}

.panel-title {
    width: 1fr;
    color: #6F8190;
    text-style: bold;
}

.panel-hint {
    width: auto;
    color: #33475C;
}

.panel-count {
    height: 1;
    padding: 0 2;
    color: #33475C;
}

#activity-scroll, #memory-scroll {
    height: 1fr;
    padding: 1 2;
    scrollbar-size: 1 1;
    scrollbar-color: #1C2B3D;
    scrollbar-color-hover: #4D8FC8;
    scrollbar-color-active: #4D8FC8;
    scrollbar-background: #0D1520;
}

/* ── Centre: the wave floats on bare background ─────────────── */

#center-column {
    width: 2fr;
    min-width: 24;
    height: 100%;
    layout: vertical;
    padding: 1 2;
}

#viz {
    width: 100%;
    height: 1fr;
    background: #080D14;
}

#input-bar {
    height: 2;
    layout: horizontal;
    padding: 0 1;
    background: #080D14;
    border-bottom: solid #1C2B3D;
}

#input-prompt {
    width: 2;
    color: #66D9EF;
    text-style: bold;
    content-align: left middle;
}

#input-field {
    width: 1fr;
    height: 1;
    background: #080D14;
    color: #D9E2E8;
    border: none;
    padding: 0;
}

#input-field:focus { border: none; }

#input-field > .input--placeholder {
    color: #33475C;
}

#listening-bar {
    display: none;
    width: 1fr;
    height: 1;
    content-align: left middle;
}

/* ── Memory entries ─────────────────────────────────────────── */

.chat-msg {
    margin: 0 0 1 0;
}

.thinking-msg {
    text-style: italic;
    margin: 0 0 1 0;
}

.section-label {
    color: #33475C;
    margin: 0 0 1 0;
}

/* ── Activity ledger ────────────────────────────────────────── */

.activity-event {
    margin: 0 0 1 0;
}
