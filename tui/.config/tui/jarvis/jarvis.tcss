/* Jarvis TUI — Nord theme, 3-panel layout */

Screen {
    background: #2E3440;
    color: #ECEFF4;
}

/* ── Top status bar ─────────────────────────────────────────── */

#status-bar {
    dock: top;
    height: 3;
    background: #3B4252;
    color: #ECEFF4;
    padding: 0 2;
    layout: horizontal;
}

#status-model {
    width: 1fr;
    color: #88C0D0;
    text-style: bold;
    content-align: left middle;
}

#status-title {
    width: 1fr;
    color: #ECEFF4;
    text-style: bold;
    content-align: center middle;
}

#status-info {
    width: 1fr;
    content-align: right middle;
    color: #4C566A;
}

/* ── Main layout: chat left, actions right ──────────────────── */

#main-area {
    layout: horizontal;
    height: 1fr;
}

#chat-scroll {
    width: 3fr;
    border: round #4C566A;
    border-title-color: #88C0D0;
    border-title-style: bold;
    padding: 0 1;
    scrollbar-color: #4C566A;
    scrollbar-color-hover: #88C0D0;
    scrollbar-color-active: #88C0D0;
}

#actions-scroll {
    width: 1fr;
    min-width: 30;
    border: round #4C566A;
    border-title-color: #EBCB8B;
    border-title-style: bold;
    padding: 0 1;
    scrollbar-color: #4C566A;
    scrollbar-color-hover: #EBCB8B;
    scrollbar-color-active: #EBCB8B;
}

/* ── Bottom terminal panel ──────────────────────────────────── */

#terminal-scroll {
    dock: bottom;
    height: 10;
    border: round #4C566A;
    border-title-color: #A3BE8C;
    border-title-style: bold;
    padding: 0 1;
    scrollbar-color: #4C566A;
    scrollbar-color-hover: #A3BE8C;
    scrollbar-color-active: #A3BE8C;
}

/* ── Input bar ──────────────────────────────────────────────── */

#input-bar {
    dock: bottom;
    height: 3;
    background: #3B4252;
    padding: 0 1;
    layout: horizontal;
}

#input-prompt {
    width: 4;
    color: #88C0D0;
    text-style: bold;
    content-align: left middle;
}

#input-field {
    width: 1fr;
    background: #3B4252;
    color: #ECEFF4;
    border: none;
    padding: 0;
}

#input-field:focus {
    border: none;
}

/* Scrollbar colors are set on the scroll containers above */

/* ── Chat messages ──────────────────────────────────────────── */

.user-msg {
    color: #88C0D0;
    margin: 0 0 1 0;
}

.assistant-msg {
    color: #D8DEE9;
    margin: 0 0 1 0;
}

.thinking-msg {
    color: #4C566A;
    text-style: italic;
}

/* ── Command blocks ─────────────────────────────────────────── */

.cmd-block {
    background: #3B4252;
    border: tall #4C566A;
    margin: 0 0 1 0;
    padding: 0 1;
    height: auto;
}

.cmd-block.pending {
    border: tall #EBCB8B;
}

.cmd-block.running {
    border: tall #88C0D0;
}

.cmd-block.success {
    border: tall #A3BE8C;
}

.cmd-block.failed {
    border: tall #BF616A;
}

.cmd-block.skipped {
    border: tall #4C566A;
}

.cmd-label {
    color: #D8DEE9;
    text-style: bold;
}

.cmd-text {
    color: #81A1C1;
}

.cmd-output {
    color: #D8DEE9;
    margin: 0 0 0 2;
}

.cmd-actions {
    layout: horizontal;
    height: 1;
    margin: 0;
}

/* ── Action buttons ─────────────────────────────────────────── */

.action-btn {
    min-width: 8;
    height: 1;
    margin: 0 1 0 0;
    border: none;
    text-style: bold;
}

.action-btn.run-btn {
    color: #2E3440;
    background: #A3BE8C;
}

.action-btn.skip-btn {
    color: #ECEFF4;
    background: #4C566A;
}

.action-btn.run-btn:hover {
    background: #8FAD80;
}

.action-btn.skip-btn:hover {
    background: #5E6779;
}

/* ── Terminal log ───────────────────────────────────────────── */

.terminal-line {
    color: #A3BE8C;
}

.terminal-line.error {
    color: #BF616A;
}

.terminal-line.info {
    color: #4C566A;
}

/* ── Context bar ────────────────────────────────────────────── */

.ctx-bar {
    color: #4C566A;
    height: 1;
}

.ctx-bar.warn {
    color: #EBCB8B;
}

.ctx-bar.danger {
    color: #BF616A;
}
