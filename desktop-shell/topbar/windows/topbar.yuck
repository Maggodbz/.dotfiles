;; Top bar window definition

(defwidget topbar [monitor]
  (box
    :orientation "h"
    :class       "topbar"
    :hexpand     true
    :spacing    1
    :space-evenly true

    ;; Left: workspaces
    (box :orientation "h" :class "left"
      (workspaces :monitor monitor)
    )

    ;; Center: hyper mode
    (box :orientation "h" :class "center"
      (hyper-button)
    )

    ;; Right: system indicators
    (box :orientation "h" :class "right cluster"
      :space-evenly false
      :spacing 6
      :halign "end"
      :valign "center"
      (battery)
      (backlight)
      (volume)
      (clock))
  ))

(defwindow topbar [monitor]
  :geometry   (geometry :x "0px" :y "0px" :width "100%" :height "6%" :anchor "top center")
  :exclusive  true
  :namespace  "eww-topbar"
  :windowtype "dock"
  :wm-ignore  true
  (topbar :monitor monitor))